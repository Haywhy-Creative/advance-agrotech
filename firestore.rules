rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // users/{uid} — profile owned by the signed-in user.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // scans/{scanId} — each scan carries a `uid` field for ownership.
    match /scans/{scanId} {
      allow read, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
    }

    // watchlist/{uid} — one document per user.
    match /watchlist/{uid} {
      allow read, write: if isOwner(uid);
    }

    // markets/{marketId} — public read-only price cache.
    // Seed with the Firebase console or Admin SDK; clients cannot write.
    match /markets/{marketId} {
      allow read: if true;
      allow write: if false;
    }

    // organic_plans/{planId} — saved plans are private to their owner.
    match /organic_plans/{planId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
