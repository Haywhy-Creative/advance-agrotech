# Copy to .env.local and fill in your own values. Never commit real keys.

# Firebase Auth + Firestore (required)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Gemini cloud AI fallback (optional)
VITE_GEMINI_API_KEY=

# Cloudinary image uploads (optional)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Nigerian market prices (optional override; defaults to https://api.opaindex.com)
VITE_OPAINDEX_API_URL=https://api.opaindex.com

# Python AI sidecar (optional override; defaults to http://localhost:8080)
VITE_AI_SERVICE_URL=http://localhost:8080
